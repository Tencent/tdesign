{
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "dev:components": "pnpm run --filter @tdesign/site-components dev",
    "dev:site": "pnpm run build:components && pnpm run --filter tdesign-site dev",
    "dev:theme-generator": "pnpm run --filter @tdesign/theme-generator dev",
    "build:components": "pnpm run --filter @tdesign/site-components build",
    "build:theme-generator": "pnpm run --filter @tdesign/theme-generator build",
    "build-watch:theme-generator": "pnpm run --filter @tdesign/theme-generator build:watch",
    "site": "pnpm run build:components && pnpm run --filter tdesign-site build",
    "site:preview": "pnpm run build:components && pnpm run --filter tdesign-site site:preview",
    "auto-release-collection": "pnpm run --filter auto-release-collection start",
    "test": "pnpm -r run --if-present test",
    "lint": "run-p lint:css lint:js lint:eslint && run-s typecheck",
    "lint:css": "stylelint \"**/*.{css,wxss,less,vue}\" --allow-empty-input --cache",
    "lint:js": "prettier --check \"**/*.{vue,js,ts,jsx,tsx,json,md}\"",
    "lint:eslint": "eslint . --max-warnings 0 --cache",
    "lint:css:fix": "stylelint \"**/*.{css,wxss,less,vue}\" --fix --allow-empty-input --cache",
    "lint:js:fix": "prettier --write \"**/*.{vue,js,ts,jsx,tsx,json,md}\"",
    "lint:eslint:fix": "eslint . --fix --max-warnings 0 --cache",
    "lint:fix": "pnpm run lint:css:fix && pnpm run lint:js:fix && pnpm run lint:eslint:fix",
    "typecheck": "pnpm -r run --if-present typecheck",
    "format": "pnpm run lint:js:fix",
    "build": "pnpm -r run --if-present build",
    "prepare": "husky install"
  },
  "license": "MIT",
  "dependencies": {
    "prismjs": "^1.29.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^8.2.0",
    "@commitlint/config-conventional": "^8.2.0",
    "@eslint/js": "^10.0.1",
    "cz-conventional-changelog": "^3.0.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "husky": "^8.0.0",
    "lint-staged": "^16.3.4",
    "npm-run-all2": "^9.0.3",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.9",
    "rimraf": "^3.0.2",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-less": "^4.1.0",
    "typescript-eslint": "^8.71.1",
    "vue-eslint-parser": "^10.3.0"
  },
  "engines": {
    "pnpm": ">=9.0.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "**/*.vue": [
      "stylelint --fix",
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "**/*.{js,ts,jsx,tsx,mts,cts}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "**/*.html": [
      "prettier --write"
    ],
    "**/*.{json,jsonc,md}": [
      "prettier --write"
    ],
    "**/*.{css,less,wxss}": [
      "stylelint --fix",
      "prettier --write"
    ]
  }
}
